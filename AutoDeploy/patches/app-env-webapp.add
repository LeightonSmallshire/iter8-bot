# Webapp environment additions
#
# Write these to /app/data/webapp.env, NOT to /app/.env.
#
# /app/.env is baked into the autodeploy-iter8-deployer image and the container's
# root filesystem is read-only, so it cannot be edited in place. docker-compose.yml
# declares a second, optional env file that points at the shared iter8-bot-data
# volume:
#
#   env_file:
#     - ../.env
#     - path: /app/data/webapp.env
#       required: false
#
# compose runs inside the deployer container, so that path resolves against the
# volume, and the bot container mounts the same volume at /app/data. Being a named
# volume, it survives bot deploys and container recreation.
#
# `required: false` means a machine without this file still deploys fine; the webapp
# just reports itself unconfigured.

# --- required: without these the webapp boots but every page redirects to a 503 login ---

# Public origin. Drives the OAuth redirect URI and makes session cookies Secure.
# Must be https and must match the Discord redirect URI exactly.
WEBAPP_BASE_URL=https://trejon.smallshire.co.uk

# OAuth2 application id and client secret. Not the bot token.
DISCORD_CLIENT_ID=<oauth2 application id>
DISCORD_CLIENT_SECRET=<oauth2 client secret>

# Signs the session cookie. Any long random string; changing it logs everyone out.
#   openssl rand -hex 32
WEBAPP_SESSION_SECRET=<long random string>

# --- optional ---

# Gig finder. Without it /gigs renders a config error banner.
SKIDDLE_API_KEY=<skiddle key>

# Where the shop announces purchases. Defaults to the channel named general-idiocy.
SHOP_ANNOUNCE_CHANNEL_ID=<channel id>