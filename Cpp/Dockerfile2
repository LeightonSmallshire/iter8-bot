# syntax=docker/dockerfile:1

# --- Stage 1: Builder ---
FROM debian:13-slim AS builder

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libssl-dev \
    liblzma-dev \
    zlib1g-dev \
    libxml2-dev \
    ca-certificates \
    curl \
    libsodium-dev \
    libopus-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /dpp_temp

WORKDIR /src
COPY . .

# Link old library locations to the new ones - DPP expects them in the wrong place
RUN ln -s /usr/lib/$(gcc -dumpmachine)/libz.a /usr/lib/libz.a \
    && ln -s /usr/lib/$(gcc -dumpmachine)/liblzma.a /usr/lib/liblzma.a \
    && ln -s /usr/lib/$(gcc -dumpmachine)/libcrypto.a /usr/lib/libcrypto.a \
    && ln -s /usr/lib/$(gcc -dumpmachine)/libssl.a /usr/lib/libssl.a \
    && ln -s /usr/lib/$(gcc -dumpmachine)/libxml2.a /usr/lib/libxml2.a

ARG TARGETARCH

# RUN --mount=type=cache,target=/src/build/${TARGETARCH} \
#         rm -rf /src/build/${TARGETARCH}/*

# Build
RUN --mount=type=cache,target=/src/build/${TARGETARCH} \
    cmake -B build/${TARGETARCH} \
    && cmake --build build/${TARGETARCH} -j$(nproc) \
    && mkdir /export \
    && cp /src/build/${TARGETARCH}/discord_bot /export

